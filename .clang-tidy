# Disabled checks fall into two groups:
# - too noisy for this project (magic numbers, short names, include cleanup,
#   1-byte enums)
# - they push toward newer, denser C++ that's harder to read, and we prefer
#   plain loops and calls (ranges, [[nodiscard]] everywhere, designated
#   initializers, any_of/all_of rewrites, emplace_back)
# Recursion is allowed because query trees are recursive.
Checks: >
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  concurrency-*,
  cppcoreguidelines-*,
  misc-*,
  modernize-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -cppcoreguidelines-avoid-magic-numbers,
  -cppcoreguidelines-pro-bounds-avoid-unchecked-container-access,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -misc-include-cleaner,
  -misc-no-recursion,
  -misc-non-private-member-variables-in-classes,
  -modernize-use-designated-initializers,
  -modernize-use-emplace,
  -modernize-use-nodiscard,
  -modernize-use-ranges,
  -modernize-use-trailing-return-type,
  -performance-enum-size,
  -portability-avoid-pragma-once,
  -readability-identifier-length,
  -readability-magic-numbers,
  -readability-use-anyofallof
CheckOptions:
  # Don't count what macros expand to. Every EXPECT_EQ adds hidden branches.
  readability-function-cognitive-complexity.IgnoreMacros: true
  # A class with only "virtual ~X() = default;" doesn't need the other four.
  cppcoreguidelines-special-member-functions.AllowSoleDefaultDtor: true
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/(include|src|cli|tests|benchmarks)/.*'
FormatStyle: file
